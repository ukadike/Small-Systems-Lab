{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Small Systems Lab",
  "type": "object",
  "required": [
    "name",
    "mission",
    "pillars",
    "research_programs"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "pillars": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research_programs": {
      "type": "array",
      "items": {
        "$ref": "research-program.schema.json"
      }
    },
    "public_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
